<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="42dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/clued_logo_desc"
        android:src="@drawable/ic_clued2" />

    <ImageView
        android:layout_width="350dp"
        android:layout_height="350dp"
        android:layout_marginTop="8dp"
        android:contentDescription="@string/detective_image_desc"
        android:src="@drawable/detective_2"/>

    <TextView
        android:id="@+id/welcome_intro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/welcome_into"
        android:textColor="@color/beige"
        android:textAlignment="center"
        android:layout_marginTop="16dp"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/welcome_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/welcome_description"
        android:textColor="@color/beige"
        android:textAlignment="center"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/lblSelectTopic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/select_topic"
        android:textStyle="bold"
        android:textSize="20sp"
        android:textColor="@color/beige"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        android:labelFor="@id/topicSelector" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp"
        app:boxBackgroundMode="outline"
        app:boxStrokeColor="@color/black"
        app:boxStrokeWidth="2dp"
        app:boxCornerRadiusTopStart="16dp"
        app:boxCornerRadiusTopEnd="16dp"
        app:boxCornerRadiusBottomStart="16dp"
        app:boxCornerRadiusBottomEnd="16dp"
        app:hintEnabled="false">

        <AutoCompleteTextView
            android:id="@+id/topicSelector"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:inputType="none"
            android:text="@string/topic_household_cleaning"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textStyle="bold"
            android:background="@drawable/bg_dropdown" />
    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/btnstart"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_button_yellow"
        app:backgroundTint="@null"
        android:elevation="3dp"
        android:stateListAnimator="@animator/lift_on_touch"
        android:text="@string/btn_begin_quiz"
        android:textColor="@color/white"/>
    </LinearLayout>